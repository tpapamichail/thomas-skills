{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "activities",
          "sources",
          "useWhen",
          "avoidWhen",
          "capabilities",
          "stateAccess",
          "defaultTier",
          "maximumTier",
          "maxTurns",
          "outputContract"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "activities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["research", "mechanical", "implement", "verify", "review", "security-review"] }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["local", "external", "none"] }
          },
          "useWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "avoidWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["workspace-read", "workspace-search", "vcs-read", "external-read", "web-search", "workspace-write", "execute"]
            }
          },
          "stateAccess": { "enum": ["read-only", "execute-only", "write"] },
          "defaultTier": { "enum": ["fast", "standard", "deep"] },
          "maximumTier": { "enum": ["fast", "standard", "deep"] },
          "maxTurns": { "type": "integer", "minimum": 1 },
          "outputContract": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
