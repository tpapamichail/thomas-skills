{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "prompt", "classification", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["delegate", "activity", "source", "risk"],
            "properties": {
              "delegate": { "type": "boolean" },
              "activity": { "type": "string", "minLength": 1 },
              "source": { "enum": ["local", "external", "none"] },
              "risk": { "enum": ["low", "normal", "high"] },
              "requestedAgent": { "type": "string", "minLength": 1 },
              "requiredCapabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "tier"],
            "properties": {
              "agent": { "type": "string", "minLength": 1 },
              "tier": { "enum": ["fast", "standard", "deep"] }
            }
          }
        }
      }
    }
  }
}
