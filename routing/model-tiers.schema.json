{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-tiers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tiers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rank", "effort", "description"],
        "properties": {
          "id": { "enum": ["fast", "standard", "deep"] },
          "rank": { "type": "integer", "minimum": 0, "maximum": 2 },
          "effort": { "enum": ["low", "medium", "high"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
