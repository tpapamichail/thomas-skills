{
  "name": "@tpapamichail/thomas-skills",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Portable test-first workflow and agent-first model routing for coding harnesses.",
  "license": "MIT",
  "files": [
    "plugin.json",
    "extensions/pi-agent-routing.mjs",
    "routing/agents.json",
    "routing/model-tiers.json",
    "skills",
    "src/pi-config.mjs",
    "src/pi-routing.mjs",
    "src/routing.mjs",
    "rules/session-rules.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent-skills",
    "pi-package",
    "agent-routing",
    "tdd",
    "git-flow"
  ],
  "scripts": {
    "test": "node --test",
    "generate": "node scripts/generate-agent-adapters.mjs",
    "check:generated": "node scripts/generate-agent-adapters.mjs --check",
    "configure:opencode": "node scripts/generate-agent-adapters.mjs --only opencode"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-agent-routing.mjs"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./extensions/pi-agent-routing.mjs"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "1.3.7"
  }
}
